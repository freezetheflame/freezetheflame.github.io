    {"type":"text","id":"s2_title","x":50,"y":480,"text":"Matrix Absorption 算子级优化","fontSize":20,"fontFamily":1,"strokeColor":"#1e1e1e","originalText":"Matrix Absorption 算子级优化","autoResize":true},

    {"type":"rectangle","id":"bg_abs","x":40,"y":510,"width":980,"height":180,"backgroundColor":"#e5dbff","fillStyle":"solid","roundness":{"type":3},"strokeColor":"#d0bfff","strokeWidth":1,"opacity":30},

    {"type":"text","id":"abs_explain1","x":60,"y":525,"text":"常规计算（低效）:","fontSize":16,"fontFamily":1,"strokeColor":"#1e1e1e","originalText":"常规计算（低效）:","autoResize":true},
    {"type":"text","id":"abs_formula1","x":60,"y":550,"text":"K_proj = Latent_KV @ W_UK    (展开 latent 到全 K)","fontSize":14,"fontFamily":1,"strokeColor":"#757575","originalText":"K_proj = Latent_KV @ W_UK    (展开 latent 到全 K)","autoResize":true},
    {"type":"text","id":"abs_formula1b","x":60,"y":572,"text":"A = Q @ K_proj^T              (注意力计算)","fontSize":14,"fontFamily":1,"strokeColor":"#757575","originalText":"A = Q @ K_proj^T              (注意力计算)","autoResize":true},

    {"type":"text","id":"abs_explain2","x":60,"y":610,"text":"Matrix Absorption（高效）:","fontSize":16,"fontFamily":1,"strokeColor":"#1e1e1e","originalText":"Matrix Absorption（高效）:","autoResize":true},
    {"type":"text","id":"abs_formula2","x":60,"y":635,"text":"Q_absorbed = Q @ W_UK^T       (将 W_UK 吸收进 Q)","fontSize":14,"fontFamily":1,"strokeColor":"#22c55e","originalText":"Q_absorbed = Q @ W_UK^T       (将 W_UK 吸收进 Q)","autoResize":true},
    {"type":"text","id":"abs_formula2b","x":60,"y":655,"text":"A = Q_absorbed @ Latent_KV^T  (直接在 latent space 计算，无需展开)","fontSize":14,"fontFamily":1,"strokeColor":"#22c55e","originalText":"A = Q_absorbed @ Latent_KV^T  (直接在 latent space 计算，无需展开)","autoResize":true},

    {"type":"text","id":"abs_note","x":560,"y":525,"text":"关键洞察:","fontSize":18,"fontFamily":1,"strokeColor":"#8b5cf6","originalText":"关键洞察:","autoResize":true},
    {"type":"text","id":"abs_note1","x":560,"y":555,"text":"将 KV 的 up-projection (W_UK, W_UV)","fontSize":14,"fontFamily":1,"strokeColor":"#1e1e1e","originalText":"将 KV 的 up-projection (W_UK, W_UV)","autoResize":true},
    {"type":"text","id":"abs_note2","x":560,"y":575,"text":"吸收进 Q 的计算中","fontSize":14,"fontFamily":1,"strokeColor":"#1e1e1e","originalText":"吸收进 Q 的计算中","autoResize":true},
    {"type":"text","id":"abs_note3","x":560,"y":600,"text":"计算过程中无需显式展开 latent KV","fontSize":14,"fontFamily":1,"strokeColor":"#1e1e1e","originalText":"计算过程中无需显式展开 latent KV","autoResize":true},
    {"type":"text","id":"abs_note4","x":560,"y":625,"text":"等价于在更低维的空间做注意力计算","fontSize":14,"fontFamily":1,"strokeColor":"#1e1e1e","originalText":"等价于在更低维的空间做注意力计算","autoResize":true},
    {"type":"text","id":"abs_note5","x":560,"y":650,"text":"需自定义 CUDA kernel 实现此吸收操作","fontSize":14,"fontFamily":1,"strokeColor":"#f59e0b","originalText":"需自定义 CUDA kernel 实现此吸收操作","autoResize":true}
